# Multi-stage build for the NestJS API (also used by the worker image).
FROM node:22-bookworm-slim AS deps
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/database/package.json packages/database/
COPY packages/shared/package.json packages/shared/
COPY packages/localization/package.json packages/localization/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
RUN pnpm install --frozen-lockfile --filter @influencehub/api... --filter @influencehub/worker... --filter @influencehub/database...

FROM deps AS build
COPY packages packages
COPY apps/api apps/api
COPY apps/worker apps/worker
RUN pnpm --filter @influencehub/shared build \
 && pnpm --filter @influencehub/database build \
 && pnpm --filter @influencehub/api build \
 && pnpm --filter @influencehub/worker build \
 && pnpm deploy --filter @influencehub/worker --prod /out/worker --legacy \
 && pnpm deploy --filter @influencehub/api --prod /out/api --legacy

FROM node:22-bookworm-slim AS api
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/api ./
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/packages/database/prisma ./prisma
USER node
EXPOSE 4000
CMD ["node", "dist/main.js"]

FROM node:22-bookworm-slim AS worker
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/worker ./
COPY --from=build /repo/apps/worker/dist ./dist
USER node
CMD ["node", "dist/main.js"]
