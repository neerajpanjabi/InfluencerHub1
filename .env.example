# ─── InfluenceHub environment (copy to .env and to apps/api/.env) ───
# NEVER commit real secrets. In production inject via your secret manager.
APP_ENV=development                       # development | test | staging | production
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Public base URL of the API as seen by browsers/OAuth providers (served via the web app proxy)
API_PUBLIC_URL=http://localhost:3000/api/v1
DATABASE_URL=postgresql://influencehub:influencehub@localhost:5432/influencehub?schema=public
REDIS_URL=redis://localhost:6379
QUEUE_ENABLED=true

# Secrets — generate with: openssl rand -base64 48  /  openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=                            # base64 of exactly 32 random bytes (AES-256-GCM)
COOKIE_DOMAIN=

# Google OAuth (business login) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram API with Instagram Login (Meta app, App Review required for insights)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v23.0
# TikTok Login Kit + Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Simulated social provider for local dev/tests ONLY (forced off in production)
SOCIAL_SANDBOX_ENABLED=true

# Payments: sandbox (dev/test only) | stripe
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret-change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI discovery: none (rules-based parser) | anthropic
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Email / SMS
SMTP_URL=
EMAIL_FROM="InfluenceHub <no-reply@influencehub.local>"
SMS_PROVIDER=console

# Storage
STORAGE_DRIVER=local                       # local | s3
UPLOAD_DIR=./storage/uploads
S3_BUCKET=
S3_REGION=me-central-1
S3_ENDPOINT=
MAX_UPLOAD_MB=15

# Seeding
SEED_ADMIN_EMAIL=admin@influencehub.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=false
