// InfluenceHub — PostgreSQL schema (Prisma)
// Conventions:
//  * UUID primary keys, UTC timestamps (timestamptz), snake_case table names.
//  * Money: Decimal(14,2) + ISO currency (AED default). Never floats.
//  * Financial rows (payments, ledger, invoices, commissions, refunds, payouts) are never
//    cascade-deleted. Users are soft-deleted / anonymised instead (see DATABASE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── ENUMS ─────────────────────────────

