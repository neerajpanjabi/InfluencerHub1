model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_settings")
}

model IntegrationConfig {
  id            String    @id @default(uuid()) @db.Uuid
